# DeepSeek V4 Pro。仅在服务端进程中设置，不要把真实密钥写入本文件或前端代码。
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_API_URL=https://api.deepseek.com/chat/completions
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=deepseek-v4-pro
TEXT_MODEL_REASONING_EFFORT=high
TEXT_MODEL_MAX_OUTPUT_TOKENS=65536
TEXT_MODEL_TIMEOUT_MS=120000
EGTE_MODEL_VERSION=EGTE_CRED_RAID_20261023
EGTE_HUMAN_MAX_SCORE=0.50
EGTE_AI_MIN_SCORE=0.80
EGTE_DOMINANCE_MIN_RATIO=0.60
# 句级AI检测：Node服务端通过本机HTTP调用独立算法服务；完整路径可按实际接口调整。
EGTE_API_URL=http://127.0.0.1:8011
EGTE_API_KEY=
EGTE_TIMEOUT_MS=600000
