# DeepSeek V4 Pro。仅在服务端进程中设置，不要把真实密钥写入本文件或前端代码。
TEXT_MODEL_PROVIDER=deepseek
TEXT_MODEL_API_URL=https://api.deepseek.com/chat/completions
TEXT_MODEL_API_KEY=
TEXT_MODEL_NAME=deepseek-v4-pro
TEXT_MODEL_REASONING_EFFORT=high
TEXT_MODEL_MAX_OUTPUT_TOKENS=65536
TEXT_MODEL_TIMEOUT_MS=600000
EGTE_MODEL_VERSION=EGTE_CRED_RAID_20261023
EGTE_HUMAN_MAX_SCORE=0.50
EGTE_AI_MIN_SCORE=0.80
EGTE_DOMINANCE_MIN_RATIO=0.60
# 句级AI检测：当前服务器直接调用8012批量推理接口；旧8011适配服务仍可显式配置。
EGTE_API_URL=http://127.0.0.1:8012/api/v1/infer/batch
EGTE_API_KEY=
EGTE_BATCH_SIZE=200
EGTE_TIMEOUT_MS=600000

# 新闻/小说链接专用解析代理，与学术8010完全独立。
TEXT_IMPORT_PARSER_ENABLED=1
TEXT_IMPORT_PARSER_URL=http://127.0.0.1:8013/api/v1/html/parse
TEXT_IMPORT_PARSER_TIMEOUT_MS=90000

# 动态新闻/小说页面的独立浏览器渲染服务；仅在常规提取失败时调用。
TEXT_IMPORT_BROWSER_ENABLED=1
TEXT_IMPORT_BROWSER_URL=http://127.0.0.1:8014/api/v1/render
TEXT_IMPORT_BROWSER_TIMEOUT_MS=60000
