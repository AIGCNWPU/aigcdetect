# 统一部署环境变量（复制为 .env 后按机器改）
#
# 结构：
#   web(网关, Node)  :8080  ──/api/v1/audio/*──▶  audio(FastAPI) :8000
#                            ──/api/v1/text/*───▶  text(FastAPI)  :8010
#
# 只启 web 时，未实现场景返回 501；PROXY_BACKEND=1 后音频/学术请求转发给后端。

# ---------- web（Node 网关 + 静态页面）----------
HOST=0.0.0.0
PORT=8080
# 开启后按前缀代理到下面两个后端
PROXY_BACKEND=1
# 大 PDF / MinerU 可能跑很久，默认 30 分钟
PROXY_TIMEOUT_MS=1800000

# ---------- 后端地址 ----------
AUDIO_BACKEND_URL=http://127.0.0.1:8000
BACKEND_URL=http://127.0.0.1:8010

# ---------- audio（backend/server.py）----------
# 模型权重目录：下含 Qwen2.5-Omni-7B / HoliAntiSpoof
MODEL_ROOT=/mnt/vos-6d37s2q0/users/zqy/models
# 分人检测：spoof_diarization 包所在目录（不配则 /audio/forgery?mode=dialogue 返回 503）
SPOOFDIAR_ROOT=/mnt/vos-6d37s2q0/users/zqy/projects/spoof-diarization
# 分离器
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cuda:0
# 0 = 自动判断人数（必须保留 0，否则单人音频会被硬拆成两半）
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_MIN_SPEECH_SECONDS=1.0
# pyannote 需要的 HF token 变量名（值从环境读）
DIARIZATION_TOKEN_ENV=HF_TOKEN
HF_TOKEN=
# 分人判定线（与离线评测一致，val 上按说话人级 EER 选定）
DIALOGUE_THRESHOLD=0.99593
# 第二位说话人至少要有多少语音才算"真的两个人"
DIALOGUE_MIN_SECOND_SPEAKER_SEC=2.0
DIALOGUE_MIN_SECOND_SPEAKER_RATIO=0.05
DIALOGUE_MAX_SPEAKERS=4
# 掩码参数（与 spoof_diarization/config.yaml 默认一致）
MASK_PAD=0.05
MASK_FADE=0.02
MASK_FILL=noise
MASK_NOISE_DBFS=-60

# ---------- 其他（按需）----------
# VLAFORGE_SERVICE_URL=http://127.0.0.1:8601
