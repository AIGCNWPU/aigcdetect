[Unit]
Description=AIGC resident inference daemon (DDA + SEED kept loaded)
After=network.target

[Service]
Type=simple
# 正式服务器：选一张常驻卡（启动时该卡应空闲；负载由部署脚本挑选）
Environment=AIGC_PLATFORM_ROOT=/mnt/vos-6d37s2q0/users/ljw/projects/aigc_platform
Environment=AIGC_INFERENCE_PORT=8617
ExecStart=/mnt/vos-6d37s2q0/users/ljw/conda/envs/aigc-forensics-runtime/bin/python /mnt/vos-6d37s2q0/users/ljw/projects/aigc_platform/project/scripts/image-validation/inference_daemon.py --gpu 1 --models mirror,seed
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
