{
  "name": "aigcdetect",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VERITAS 智鉴 · 文本、图片、视频与音频检测平台",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs --dist",
    "start:text-import-parser": "node services/text-import-parser/server.mjs",
    "start:text-browser-renderer": "node services/text-browser-renderer/server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "verify:egte": "node scripts/verify-egte.mjs",
    "verify:text-stack": "node scripts/verify-text-stack.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AIGCNWPU/aigcdetect.git"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
