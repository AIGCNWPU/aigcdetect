TEXT_BROWSER_RENDERER_HOST=127.0.0.1
TEXT_BROWSER_RENDERER_PORT=8014
TEXT_BROWSER_RENDERER_TIMEOUT_MS=60000
TEXT_BROWSER_RENDERER_SETTLE_MS=3000
TEXT_BROWSER_RENDERER_MAX_CONCURRENCY=2
TEXT_BROWSER_RENDERER_MAX_QUEUE=8
# 可选：使用服务器已有的Chrome/Chromium，避免下载Playwright浏览器。
