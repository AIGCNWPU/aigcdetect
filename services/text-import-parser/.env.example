# 独立MinerU 4.x命令。也可写成绝对路径，例如 ["/path/to/mineru"]。
MINERU_COMMAND_JSON=["mineru"]
# 官方MinerU 4.x：mineru parse <input> -o <output.md>
MINERU_ARGS_JSON=["parse","{input}","-o","{output_file}"]
# 旧版CLI可改为：["-p","{input}","-o","{output_dir}"]
MINERU_TIMEOUT_MS=90000
TEXT_IMPORT_PARSER_HOST=127.0.0.1
TEXT_IMPORT_PARSER_PORT=8013
