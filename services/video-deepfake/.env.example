# DeepSeek 视觉复核（可选）。复制为 .env 后填入 Key；.env 已被 Git 忽略。
DEEPSEEK_API_KEY=
# 官方地址或 OpenAI 兼容代理
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉模型名称
DEEPSEEK_VISION_MODEL=deepseek-flash
# 复核模式：off 关闭；low 只复核本地低风险结果（默认）；always 每次检测都复核
DEEPSEEK_REVIEW_MODE=low
# 单次检测最多复核几张代表画面（1-6）
DEEPSEEK_MAX_FRAMES=4
# 并发请求数（1-8）
DEEPSEEK_WORKERS=4
# 单张画面请求超时（秒）
DEEPSEEK_TIMEOUT=25
# 视觉模型概率分档；用于把复核结果升级为人物/整片风险
DEEPSEEK_MEDIUM_THRESHOLD=0.5
DEEPSEEK_HIGH_THRESHOLD=0.8
