# DeepSeek 视觉复核（可选）。复制为 .env 后填入 Key；.env 已被 Git 忽略。
DEEPSEEK_API_KEY=
# 官方地址或 OpenAI 兼容代理
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 视觉模型名称
DEEPSEEK_VISION_MODEL=deepseek-flash
# 复核模式：off 关闭；low 只复核本地低风险结果（默认）；always 每次检测都复核
DEEPSEEK_REVIEW_MODE=low
# 单次检测最多复核几张代表画面（1-6）
DEEPSEEK_MAX_FRAMES=4
# 并发请求数（1-8）
DEEPSEEK_WORKERS=4
# 单张画面请求超时（秒）
DEEPSEEK_TIMEOUT=25
# 是否为中/高风险可疑时间段生成一句视觉复核说明
DEEPSEEK_EXPLAIN_SEGMENTS=on
# 单次检测最多解释几个可疑时间段（0-30）
DEEPSEEK_MAX_SEGMENTS=12
# 每个可疑时间段最多送几张代表人脸画面（1-4）
DEEPSEEK_EXPLAIN_FRAMES=2
# 片段解释并发数（1-8）
DEEPSEEK_EXPLAIN_WORKERS=4
# 是否检查画面中可见的AI生成标识/水印
DEEPSEEK_VISUAL_MARKER=on
# 每次检测最多送几张完整视频画面做标识检查（1-12）
DEEPSEEK_VISUAL_MARKER_FRAMES=6
# 画面标识检查并发数（1-8）
DEEPSEEK_VISUAL_MARKER_WORKERS=4
# 画面标识置信度阈值（0.1-0.99）
DEEPSEEK_VISUAL_MARKER_CONFIDENCE=0.6
# 视觉模型概率分档；用于把复核结果升级为人物/整片风险
DEEPSEEK_MEDIUM_THRESHOLD=0.5
DEEPSEEK_HIGH_THRESHOLD=0.8
