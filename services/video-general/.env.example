# 复制为 .env 后填入 DeepSeek API Key（.env 已被 Git 忽略）
DEEPSEEK_API_KEY=<your-deepseek-api-key>
# 可选：官方地址或兼容代理
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可选：视觉模型名称
DEEPSEEK_VISION_MODEL=deepseek-flash
# 可选：最多复核几个可疑片段 / 每个片段最多送几张代表帧 / 并发数
DEEPSEEK_MAX_SEGMENTS=12
DEEPSEEK_MAX_FRAMES=4
DEEPSEEK_WORKERS=4
# 可选：请求超时（秒）
DEEPSEEK_TIMEOUT=25
