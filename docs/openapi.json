  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "AiSentenceSegment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segmentId",
          "sentenceIndex",
          "sentenceIndexes",
          "sentenceCount",
          "merged",
          "paragraphIndex",
          "start",
          "end",
          "text"
        ],
        "properties": {
          "segmentId": {
            "type": "string"
          },
          "sentenceIndex": {
            "type": "integer",
            "minimum": 1
          },
          "sentenceIndexes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "sentenceCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "merged": {
            "type": "boolean"
          },
          "paragraphIndex": {
            "type": "integer",
            "minimum": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string"
          }
        }
      },
      "NewsAnalysisRequest": {
        "type": "object",
        "required": [
          "action",
          "material",
          "checks"
        ],
        "properties": {
          "action": {
            "const": "analyze"
          },
          "material": {
            "type": "object",
            "required": [
              "title",
              "content"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "content": {
                "type": "string",
                "maxLength": 50000
              },
              "language": {
                "type": "string",
                "enum": [
                  "zh",
                  "en"
                ]
              },
              "aiSegments": {
                "type": "array",
                "maxItems": 10000,
                "items": {
                  "$ref": "#/components/schemas/AiSentenceSegment"
                }
              },
              "source": {
                "type": "object"
              }
            }
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "proofreading",
                "ai-risk"
              ]
            }
          }
        }
      },
      "NovelAnalysisRequest": {
        "type": "object",
        "required": [
          "action",
          "work",
          "chapters",
          "checks"
        ],
        "properties": {
          "action": {
            "const": "analyze"
          },
          "work": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string",
                "maxLength": 120
              },
              "language": {
                "type": "string",
                "enum": [
                  "zh",
                  "en"
                ]
              }
            }
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "localId",
                "title",
                "content"
              ],
              "properties": {
                "localId": {
                  "type": "string"
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                },
                "content": {
                  "type": "string",
                  "maxLength": 100000
                },
                "platform": {
                  "type": "string",
                  "enum": [
                    "ciweimao",
                    "faloo",
                    "zongheng",
                    "fanqie",
                    "qidian",
                    "unknown"
                  ],
                  "description": "章节发布平台；链接输入时由前端自动匹配，无法识别时使用unknown。"
                },
                "language": {
                  "type": "string",
                  "enum": [
                    "zh",
                    "en"
                  ]
                },
                "aiSegments": {
                  "type": "array",
                  "maxItems": 10000,
                  "items": {
                    "$ref": "#/components/schemas/AiSentenceSegment"
                  }
                },
                "source": {
