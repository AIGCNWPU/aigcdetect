    "/api/v1/image/refund": {
      "post": {
        "operationId": "image_refund",
        "tags": [
          "AI图片检测"
        ],
        "summary": "准备当前分析材料",
        "parameters": [],
        "responses": {
          "200": {
            "description": "当前内存会话的实际处理结果。"
          },
          "400": {
            "description": "输入无效。"
          },
          "403": {
            "description": "请求不是来自本机页面。"
          },
          "404": {
            "description": "会话或任务不存在、已关闭或已过期。"
          },
          "405": {
            "description": "已知接口的请求方法不正确。",
            "headers": {
              "Allow": {
                "description": "该路由接受的请求方法。",
                "schema": {
                  "type": "string",
                  "enum": [
                    "POST"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "会话已关闭或材料关联不一致。"
          },
          "413": {
            "description": "材料超出大小限制。"
          },
          "503": {
            "description": "检测能力未配置或临时空间不可用。"
          }
        },
        "x-implemented": true,
        "x-page-route": "/image/refund",
        "x-source-page": 7,
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id",
                  "fields",
                  "files"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^c_[a-f0-9]{24}$",
                    "description": "每次材料版本的随机临时会话编号。"
                  },
                  "fields": {
                    "type": "object",
                    "required": [
                      "caseNumber",
                      "productName",
                      "style",
                      "productInfo",
                      "description"
                    ],
                    "properties": {
                      "caseNumber": {
                        "type": "string"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "style": {
                        "type": "string"
                      },
                      "productInfo": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "files": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10,
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "type",
                        "data"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "image/jpeg",
                            "image/png",
                            "image/webp"
                          ]
                        },
                        "data": {
                          "type": "string",
                          "contentEncoding": "base64",
                          "description": "原始图片字节，单张不超过5 MiB；仅用于当前分析。"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
