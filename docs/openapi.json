    "/api/v1/text/news": {
      "post": {
        "operationId": "text_news",
        "tags": [
          "AI文本检测"
        ],
        "summary": "AI新闻稿与投稿内容检测",
        "description": "调用EGTE执行句级AI检测，并由大模型执行新闻三审三校；结果均附原文。",
