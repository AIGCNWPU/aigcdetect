              "schema": {
                "$ref": "#/components/schemas/NewsAnalysisRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "返回通过服务端原文回查的真实模型分析结果及覆盖范围；内部证据拒绝计数不进入客户端响应。"
          },
          "400": {
            "description": "请求字段或正文无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "所选检测项尚未支持。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "模型上游不可用或返回无效结构。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "服务端模型配置缺失或无效。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
