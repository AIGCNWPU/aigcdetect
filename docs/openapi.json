          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fields",
                  "videos"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^v_[a-f0-9-]{36}$"
                  },
                  "fields": {
                    "type": "object",
                    "required": [
                      "caseNumber",
                      "productName",
                      "style",
                      "productInfo",
                      "description"
                    ],
                    "properties": {
                      "caseNumber": {
                        "type": "string"
                      },
                      "productName": {
                        "type": "string"
                      },
                      "style": {
                        "type": "string"
                      },
                      "productInfo": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      }
                    }
                  },
                  "videos": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 5,
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "version",
                        "type",
                        "size",
                        "duration",
                        "width",
                        "height"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "version": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "type": {
                          "enum": [
                            "video/mp4",
                            "video/webm"
                          ]
                        },
                        "size": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 209715200
                        },
                        "duration": {
                          "type": "number",
                          "exclusiveMinimum": 0,
                          "maximum": 600
                        },
                        "width": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4096
                        },
                        "height": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 4096
                        }
                      }
                    }
